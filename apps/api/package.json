    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^9.15.0",
    "helmet": "^8.0.0",
    "mongodb-memory-server": "^11.3.0",
    "mongoose": "^8.9.0",
    "multer": "^2.0.2",
    "nodemailer": "^6.9.16",
