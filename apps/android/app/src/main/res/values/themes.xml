<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CampusCare" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/cream</item>
    </style>
    <style name="Theme.CampusCare.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/forest</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_shield</item>
        <item name="postSplashScreenTheme">@style/Theme.CampusCare</item>
    </style>
</resources>
