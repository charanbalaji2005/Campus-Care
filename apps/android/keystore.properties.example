# Copy to keystore.properties (never commit it) to sign release builds locally.
# Create a key once with:
#   keytool -genkeypair -v -keystore campuscare-release.jks -keyalg RSA -keysize 4096 -validity 10000 -alias campuscare
storeFile=campuscare-release.jks
storePassword=CHANGE_ME
keyAlias=campuscare
keyPassword=CHANGE_ME
