<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: allow plain HTTP to the Android emulator's host loopback for local development.
     To test on a real phone against a local API, add your computer's LAN IP here (debug only). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
